# ==============================================================================
# BTC-ML System — Environment Configuration Template
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL CREDENTIALS.
# DO NOT COMMIT THE .env FILE TO VERSION CONTROL.
# ==============================================================================

# Alpaca Paper Trading Credentials (Required for live paper trading)
ALPACA_API_KEY=your_alpaca_paper_api_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_key_here
ALPACA_ENDPOINT=https://paper-api.alpaca.markets/v2
ALPACA_DATA_ENDPOINT=https://data.alpaca.markets

# Analytical Database Path (Defaults to data/btc_ml_system.duckdb)
DUCKDB_PATH=data/btc_ml_system.duckdb

# Trading Mode: "strict" (locked baseline) | "loose_stage1" (temporary loosening)
TRADING_MODE=strict

# Safety Assertion: Must remain false to prohibit real-money execution
ALLOW_LIVE_MONEY_TRADING=false
